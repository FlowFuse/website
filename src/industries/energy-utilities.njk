#                       reads this instead when it's set.
#   skipIndex         - keeps it out of sitemap-legacy.xml; Nuxt's own sitemap
#                       picks the real page up from its static route.
# Delete this file once /industries/ itself is migrated to Nuxt.
permalink: false
migratedUrl: /industries/energy-utilities/
skipIndex: true
