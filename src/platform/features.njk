    <style>
        .wip-tab { display:block; padding:0.6rem 0 0.6rem 1.25rem; margin-left:-1px; border-left:2px solid transparent; color:#6b7280; font-weight:500; transition:color .2s ease, border-color .2s ease; }
        .wip-tab:hover { color:#4f46e5; }
        .wip-tab.is-active { color:#4f46e5; border-left-color:#4f46e5; }
        /* Tailwind gap-20/scroll-mt-24 don't compile in the legacy CSS build, so space the steps here */
        .wip-step { scroll-margin-top: 6rem; }
        .wip-step + .wip-step { margin-top: 5rem; padding-top: 5rem; border-top: 1px solid #f1f1f4; }
        .wip-hero-img { align-self: start; border-radius: 0.5rem; overflow: hidden; box-shadow: 0 12px 32px rgba(2,6,13,0.12); border: 1px solid #e5e7eb; }
        .wip-hero-img img { display: block; width: 100%; height: auto; }
        /* ff-btn is display:flex (full-width); keep the pricing CTAs sized to their content */
        .wip-step .ff-btn { display: inline-flex; }
    </style>
    <script>
        // Active-tab tracking for the "What's inside the platform" section.
        // IntersectionObserver (not scroll+rAF) — highlights the tab whose step crosses the viewport's vertical middle.
        (function () {
            var tabs = {};
            document.querySelectorAll('.wip-tab').forEach(function (t) { tabs[t.getAttribute('href').slice(1)] = t; });
            var steps = document.querySelectorAll('.wip-step');
            if (!steps.length) return;
            var obs = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        Object.keys(tabs).forEach(function (k) { tabs[k].classList.remove('is-active'); });
                        if (tabs[e.target.id]) tabs[e.target.id].classList.add('is-active');
                    }
                });
            }, { rootMargin: '-45% 0px -45% 0px', threshold: 0 });
            steps.forEach(function (s) { obs.observe(s); });
        })();
    </script>
