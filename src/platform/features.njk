                    <div class="ff-hero-3d w-full" style="perspective: 1200px;">
                        <div class="ff-hero-3d__inner ff-image-cover rounded-lg shadow-2xl border border-gray-200" style="transform-style: preserve-3d; transform-origin: center center; will-change: transform; transform: rotateY(-8deg);">
                            {% image "./images/features/flowfuse-features-hero.png", "FlowFuse Features", [750] %}
                        </div>
                    </div>
                </div>
                <script>
                // Scroll-driven 3D rotation for the hero image (n8n-style): a flat PNG on a CSS
                // perspective plane that eases from a tilt to flat as you scroll down the page.
                (function () {
                    var wrap = document.querySelector('.ff-hero-3d');
                    if (!wrap) return;
                    var inner = wrap.querySelector('.ff-hero-3d__inner');
                    if (!inner) return;
                    var START_Y = -8;  // starting rotateY in degrees (0 = flat facing viewer); negative = left edge recedes
                    var DIST = 500;    // px of scroll over which it flattens
                    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                        inner.style.transform = 'none'; return; // respect reduced-motion
                    }
                    var ticking = false;
                    function update() {
                        ticking = false;
                        var y = window.scrollY || window.pageYOffset || 0;
                        var p = Math.max(0, Math.min(1, y / DIST));
                        inner.style.transform = 'rotateY(' + (START_Y * (1 - p)).toFixed(2) + 'deg)';
                    }
                    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
                    window.addEventListener('scroll', onScroll, { passive: true });
                    window.addEventListener('resize', onScroll, { passive: true });
                    update();
                })();
                </script>
