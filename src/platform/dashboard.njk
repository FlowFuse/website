<script>
(function () {
    var dash = document.getElementById('ffd-dash');
    if (!dash) { return; }

    var body = document.getElementById('ffd-events');
    var g1 = document.getElementById('ffd-g1');
    var g2 = document.getElementById('ffd-g2');

    /* Real epoch values, formatted in the visitor's own locale and timezone --
       which is exactly what the date/time column types do. */
    var events = [
        { m: 'Filler 2',   e: 'Recipe changeover',  t: 1787839200000, s: 'ok',   sl: 'Complete' },
        { m: 'Capper 1',   e: 'Torque out of band', t: 1787842740000, s: 'warn', sl: 'Warning'  },
        { m: 'Labeller',   e: 'Web break',          t: 1787846280000, s: 'crit', sl: 'Stopped'  },
        { m: 'Palletiser', e: 'Cycle resumed',      t: 1787849820000, s: 'ok',   sl: 'Running'  }
    ];

    var fmt = new Intl.DateTimeFormat(undefined, {
        year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
    });

    body.innerHTML = events.map(function (r) {
        return '<tr><td>' + r.m + '</td><td>' + r.e + '</td>' +
               '<td class="ffd-ts">' + fmt.format(new Date(r.t)) + '</td>' +
               '<td><span class="ffd-chip ffd-chip--' + r.s + '">' + r.sl + '</span></td></tr>';
    }).join('');

    document.querySelectorAll('.ffd-seg button[data-ffd-preset]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            btn.parentElement.querySelectorAll('button').forEach(function (b) {
                b.setAttribute('aria-pressed', String(b === btn));
            });
            var preset = btn.dataset.ffdPreset;
            dash.dataset.preset = preset;
            /* nudge the needles so a theme switch reads as live instrumentation */
            var jitter = { light: 0, dark: 6, dracula: -5, nord: 4, sepia: -3 }[preset] || 0;
            g1.setAttribute('stroke-dashoffset', String(62 + jitter));
            g2.setAttribute('stroke-dashoffset', String(118 - jitter));
        });
    });
})();
</script>
